# Переменные Railway. Реальные значения сюда не коммитим — задаются в Variables.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Авито: кабинет 1, «ГектарЪ» / Щёкинские берега ---
# Профиль → Настройки → Клиенты и приложения → создать приложение.
# Нужны права: messenger:read, messenger:write, items:info, user:read
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# --- Авито: кабинет 2, «Светлая долина» (необязательный) ---
# Отдельная пара ключей второго кабинета, те же права.
# Не заданы — кабинет просто не подключён, агент работает по одному ГектарЪ.
AVITO2_CLIENT_ID=
AVITO2_CLIENT_SECRET=

# --- Битрикс24 ---
# Разработчикам → Другое → Входящий вебхук.
# Права: crm, tasks, user. URL целиком является секретом.
BITRIX_WEBHOOK=https://gektar.bitrix24.ru/rest/1/XXXXXXXXXXXX

# --- Телеграм ---
# Токен от @BotFather; chat_id — от @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- База знаний ---
# Отдельный приватный репозиторий, подтягивается перед каждым прогоном
KB_REPO_URL=https://github.com/irikrafikov-ai/gektar-avito-kb.git
KB_TOKEN=

# --- Режим ---
# read-only | send — на обкатку ставим read-only: агент ведёт Битрикс
# и шлёт отчёты, но клиентам не пишет
AGENT_MODE=send
